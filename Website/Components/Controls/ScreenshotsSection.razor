<section id="screenshots" class="flex w-full flex-col justify-center gap-16 py-32">

    <div class="w-full md:w-2/3">
        <h2 class="text-5xl leading-snug font-bold">See Beacon in action</h2>
        <p class="mt-3 text-lg font-light text-white/50">A closer look at the screens your team will open every service.</p>
    </div>

    <div class="grid grid-cols-1 gap-4">
        @foreach (var shot in Screens)
        {
            <figure class="overflow-hidden rounded-2xl border-2 border-gray bg-con1">
                <img src="@shot.Image" alt="@shot.Alt" class="w-full" />
                <figcaption class="p-5 text-lg font-semibold">@shot.Title</figcaption>
            </figure>
        }
    </div>

</section>

@code {
    private record Screen(string Title, string Image, string Alt);

    private static readonly List<Screen> Screens = new()
    {
        new("Songs", "images/song.png", "Beacon's song library with lyrics split into stanzas and a chorus."),
        new("Bible", "images/bible.png", "Beacon's Bible screen with book, chapter and verse pickers."),
        new("Settings - General", "images/settings-general.png", "Beacon's Settings screen showing the software update card."),
        new("Settings - Song Library", "images/settings-songlibrary.png", "Beacon's Settings screen showing song collections to download."),
        new("Projector - Song Library", "images/projector.png", "Beacon's Projector display."),
    };
}
