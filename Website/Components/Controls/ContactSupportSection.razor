@using Website.Components.Controls

<section id="contact" class="relative flex w-full flex-col items-center justify-center gap-8 overflow-hidden py-32 text-center">

    <div class="pointer-events-none absolute top-1/2 left-1/2 h-96 w-96 -translate-x-1/2 -translate-y-1/2 rounded-full bg-blue/30 blur-3xl"></div>

    <div class="relative flex max-w-2xl flex-col items-center rounded-3xl border-2 border-gray bg-con1 px-12 py-16">
        <span class="bg-pale-blue rounded-full px-4 py-1 text-sm font-semibold text-blue">Support Beacon</span>
        <h2 class="mt-6 text-5xl leading-snug font-bold">Help keep it running</h2>
        <p class="mt-4 font-light text-white/50">
            Beacon is free for every team that needs it. Donations go straight into keeping it maintained, updated, and free for the next church that finds it.
        </p>
        <div class="mt-10">
            <Button><Text>DONATE NOW</Text></Button>
        </div>
    </div>

    <p class="relative font-light text-white/40">
        Need help instead? Email <a href="mailto:support@example.com" class="font-semibold text-blue">support@example.com</a>
    </p>

</section>
