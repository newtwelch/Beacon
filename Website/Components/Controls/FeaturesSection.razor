@using Website.Components.Controls

<section id="features" class="flex w-full flex-col justify-center gap-16 py-32">

    <div class="w-full md:w-2/3">
        <h2 class="text-5xl leading-snug font-bold">Built for how you actually serve</h2>
        <p class="mt-3 text-lg font-light text-white/50">The tools your media team reaches for every single week.</p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">

        <FeatureCard Title="Search Everything" Description="Look up any song by title, author, lyric, language, or tag — Beacon finds it before you finish typing.">
            <Icon>
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="7" />
                    <path d="m20 20-3.5-3.5" />
                </svg>
            </Icon>
        </FeatureCard>

        <FeatureCard Title="Build Your Lineup" Description="Queue up your set ahead of time and move through service without missing a beat.">
            <Icon>
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M8 6h13M8 12h13M8 18h13" />
                    <circle cx="4" cy="6" r="1" />
                    <circle cx="4" cy="12" r="1" />
                    <circle cx="4" cy="18" r="1" />
                </svg>
            </Icon>
        </FeatureCard>

        <FeatureCard Title="Edit Lyrics Your Way" Description="Fine-tune lyrics with manual or automatic line sequencing, built right into the app.">
            <Icon>
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 20h9" />
                    <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
                </svg>
            </Icon>
        </FeatureCard>

        <FeatureCard Title="Bible in Any Language" Description="Download Bible translations in multiple languages and keep them ready offline.">
            <Icon>
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M3 12h18" />
                    <path d="M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0-18Z" />
                </svg>
            </Icon>
        </FeatureCard>

        <FeatureCard Title="Search the Whole Bible" Description="Find any verse by keyword with full-text search across your entire library.">
            <Icon>
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5Z" />
                    <path d="M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5" />
                </svg>
            </Icon>
        </FeatureCard>

    </div>

</section>
