<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="icon" type="image/x-icon" href="/Beacon.ico">
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Website.styles.css"]" />

    <!-- Primary metadata -->
    <title>Beacon | Song & Scripture Projector</title>
    <meta name="description" content="A simple, reliable way to project songs, Bible verses, and scripture during your church services." />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Beacon" />
    <meta property="og:title" content="Beacon | Song & Scripture Projector" />
    <meta property="og:description" content="Bring songs and Scripture to your service with Beacon, a simple presentation tool built for worship and church gatherings." />
    <meta property="og:url" content="https://beacon.runasp.net/" />
    <meta property="og:image" content="https://beacon.runasp.net/images/ogimage.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Beacon, a song and scripture projector for church services." />


    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body class="font-gont">
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
