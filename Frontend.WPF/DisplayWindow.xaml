<Window x:Class="Frontend.WPF.DisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Frontend.WPF"
        mc:Ignorable="d"
        xmlns:hlpr="clr-namespace:Frontend.WPF.Helpers"
        Closing="Window_Closing" 
        ShowActivated="False"
        
        WindowStyle="None" Focusable="False"
        Background="#0A0A0A"
        Title="DisplayWindow" d:Height="720" d:Width="1280">
    <!-- =====================================
WINDOW CHROME: custom title bar and window stuff
========================================== -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" CornerRadius="0"
                      GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" Margin="48 32 48 40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0 0 0 18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" LastChildFill="False" VerticalAlignment="Center">
                <DockPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="Gontserrat" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Foreground" Value="#F5F3F5" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </DockPanel.Resources>

                <!-- song title, or the Bible book -->
                <TextBlock x:Name="Header1" Text="Amazing Grace" FontSize="44" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="RefChapter" FontSize="44" Visibility="Collapsed" />
                <TextBlock x:Name="RefColon" Text=":" FontSize="44" Visibility="Collapsed" Margin="5 0 0 0"/>
                <TextBlock x:Name="RefVerse" FontSize="44" Visibility="Collapsed"  Margin="5 0 0 0"/>
            </DockPanel>
            
            <!-- Right-side badges -->
            <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="24 0 0 0">

                <Border x:Name="KeyBadge"
                    Visibility="Collapsed"
                    Margin="0 0 10 0"
                    Padding="20 10"
                    CornerRadius="12"
                    Background="#262830">

                    <TextBlock x:Name="KeyText"
                           Text="KEY: G"
                           FontFamily="Gontserrat"
                           FontWeight="SemiBold"
                           FontSize="32"
                           Foreground="#E5E5E6" />
                </Border>

                <Border x:Name="Header2Badge"
                    Padding="20 10"
                    CornerRadius="12"
                    Background="#262830">

                    <TextBlock x:Name="Header2"
                           Text="Stanza 1 of 4" 
                           FontFamily="Gontserrat"
                           FontWeight="SemiBold"
                           FontSize="32"
                           Foreground="#E5E5E6" />
                </Border>

            </StackPanel>
        </Grid>

        <!-- Progress / Accent Line -->
        <Border x:Name="ProgressTrack"
          Grid.Row="1"
          Height="4" CornerRadius="2"
          Margin="0 0 0 24"
          Background="#262830"
          ClipToBounds="True">

            <Border x:Name="ProgressAccent"
                Width="180"
                HorizontalAlignment="Left"
                Background="#215FE5"
                CornerRadius="2" />
        </Border>

        <!-- Lyrics -->
        <hlpr:AutoFitDecorator Grid.Row="2"
                           Margin="44"
                           MinFontSize="20"
                           MaxFontSize="160">

            <hlpr:HighlightableTextBlock x:Name="Content"
                                     TextWrapping="Wrap"
                                     TextAlignment="Center"
                                     FontFamily="Gontserrat"
                                     FontWeight="Regular"
                                     Foreground="#E5E5E6"
                                     Opacity=".95"
                                     HighlightBrush="#E7AB50"
                                     HighlightCount="0" />
        </hlpr:AutoFitDecorator>

    </Grid>
</Window>
