<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <None Remove="Resources\Images\Splash.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Images\Beacon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Backend.Core\Backend.Core.csproj" />
    <ProjectReference Include="..\Frontend.UI\Frontend.UI.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	  <Version>1.2.4</Version>
	  <AssemblyVersion>1.2.4</AssemblyVersion>
	  <AssemblyName>Beacon</AssemblyName>

	  <!-- Single-File Configurations -->
	  <PublishSingleFile>true</PublishSingleFile>
	  <SelfContained>true</SelfContained>
	  <RuntimeIdentifier>win-x64</RuntimeIdentifier>

	  <!-- Critical for WPF Native Components --><!--
	  <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>-->

	  <!-- Optional: Reduces overall file size -->
	  <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
	  <DebugType>none</DebugType>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="8.0.100" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
		<PackageReference Include="Velopack" Version="0.0.1298" />
		<PackageReference Include="WpfScreenHelper" Version="2.1.1" />
	</ItemGroup>

	<ItemGroup>
	  <SplashScreen Include="Resources\Images\Splash.png">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </SplashScreen>
	</ItemGroup>

	<PropertyGroup>
		<StartupObject>Frontend.WPF.Program</StartupObject>
		<ApplicationIcon>Resources\Images\Beacon.ico</ApplicationIcon>
	</PropertyGroup>
	<Target Name="CopyBlazorContent" AfterTargets="Publish">
		<ItemGroup>
			<BlazorContent Include="..\Frontend.UI\wwwroot\**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(BlazorContent)" DestinationFolder="$(PublishDir)wwwroot\%(RecursiveDir)" SkipUnchangedFiles="true" />
	</Target>
</Project>
