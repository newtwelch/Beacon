
<div class="mb-3 flex gap-3 transition-colors">
	@foreach(var Song in Songs)
	{
		<Button OnClick="async () => await SelectionChanged(Song)" Class="@(Song.Id == SelectedSong.Id ? "bg-pale-blue text-blue" : "hover:text-blue")"><Text>@Song.Language</Text></Button>
	}
	<Button OnClick="(() => AddLanguage.InvokeAsync())"><Text>+</Text></Button>
</div>
@code {
	[Parameter]
	public List<Song> Songs { get; set; } = new();

	[Parameter]
	public Song SelectedSong { get; set; } = new Song();

	[Parameter]
	public EventCallback AddLanguage { get; set; }

	[Parameter]
	public EventCallback<Song> SelectedSongChanged { get; set; }

	private async Task SelectionChanged(Song song)
	{
		SelectedSong = song;
		await SelectedSongChanged.InvokeAsync(song);
	}
}
