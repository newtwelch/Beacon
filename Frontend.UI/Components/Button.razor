<button @onclick="OnClick" @onclick:stopPropagation="StopPropagation"
        class="@Class flex cursor-pointer items-center justify-center gap-2 rounded-md bg-con1 p-3 text-center text-xs font-bold tracking-widest uppercase hover:text-blue @(RemoveBorder ? "" : "border-2 border-gray")">

    @if (Icon != null)
    {
        <span class="max-h-4 max-w-4">@Icon</span>
    }

    @Text

</button>

@code {
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public RenderFragment? Text { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public bool StopPropagation { get; set; } = false;
    [Parameter] public bool RemoveBorder { get; set; }
    [Parameter] public string Class { get; set; } = "";
}
