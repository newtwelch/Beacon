<div class="flex flex-col gap-3 rounded-2xl bg-con2 p-6 leading-tight shadow-lg">

    <div class="flex items-start justify-between">
        <div>
            <h2 class="text-xl font-bold">Software Update</h2>
            <p class="text-sm font-light opacity-70">
                Keep your application up to date.
            </p>
        </div>

        <div class="@StatusColor rounded-full px-3 py-1 text-xs">
            @StatusText
        </div>
    </div>

    <div class="grid grid-cols-2 gap-4">

        <div class="rounded-xl bg-black/20 p-4">
            <p class="text-xs font-light opacity-60">Current Version</p>
            <p class="text-lg font-semibold">@CurrentVersion</p>
        </div>

        <div class="rounded-xl bg-black/20 p-4">
            <p class="text-xs font-light opacity-60">Latest Version</p>
            <p class="text-lg font-semibold">
                @(string.IsNullOrEmpty(LatestVersion)
                    ? "-"
                    : LatestVersion)
            </p>
        </div>

    </div>

    @if (!string.IsNullOrEmpty(ReleaseNotes))
    {
        <div class="rounded-xl bg-black/20 p-4">
            <p class="mb-2 text-sm font-semibold">Release Notes</p>

            <p class="text-sm whitespace-pre-wrap opacity-80">
                @ReleaseNotes
            </p>
        </div>
    }

    @if (Progress > 0)
    {
        <div class="flex flex-col gap-2">

            <div class="flex justify-between text-sm">
                <span>@ProgressMessage</span>
                <span>@Progress%</span>
            </div>

            <div class="h-3 w-full overflow-hidden rounded-full bg-black/30">
                <div class="h-3 bg-blue transition-all duration-300"
                     style="width:@Progress%">
                </div>
            </div>

        </div>
    }

    <Button Class="w-72"
            OnClick="OnAction">

        <Text>@ButtonText</Text>

    </Button>

</div>

@code {

    [Parameter] public string CurrentVersion { get; set; } = "";
    [Parameter] public string LatestVersion { get; set; } = "";
    [Parameter] public string ReleaseNotes { get; set; } = "";
    [Parameter] public string ButtonText { get; set; } = "";

    [Parameter] public string StatusText { get; set; } = "";
    [Parameter] public string StatusColor { get; set; } = "bg-gray-700";

    [Parameter] public int Progress { get; set; }
    [Parameter] public string ProgressMessage { get; set; } = "";

    [Parameter] public EventCallback OnAction { get; set; }

}