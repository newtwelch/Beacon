@inject IJSRuntime JSRuntime
@inject ILogger<SongList> Logger

<div tabindex="0"
     id="SongList"
     class="h-full w-full overflow-auto transition-all"
     @onkeydown="Navigate">

    <Virtualize Items="Songs"
                Context="song"
                ItemSize="64">
        @{
            var isSelected = song.Id == SelectedSong?.Id;
            var index = Songs.IndexOf(song);

            <div id="@song.Id"
                 class="group flex h-16 cursor-pointer items-center rounded-xl px-3 outline-0 transition-colors select-none
                           @(isSelected ? "bg-pale-blue text-blue" : "hover:text-blue")"
                 @onclick="() => SafeAction(() => SelectionChanged(song), nameof(SelectionChanged), song)">

                <!-- Song details -->
                <p class="flex-1 truncate leading-4 font-normal">
                    <span class="">@((MarkupString)song.Title)</span>
                    <br />
                    <span class="text-xs font-light opacity-50">
                    @if (!string.IsNullOrWhiteSpace(song.LyricText))
                        {
                            @((MarkupString)$"{song.LyricText.AddHighlight(song.LyricText)}")
                        }
                        else if (!string.IsNullOrWhiteSpace(song.Tags))
                        {
                            @((MarkupString)song.Tags)
                        }
                        else
                        {
                            @((MarkupString)song.Author)
                        }
                    </span>
                </p>

                <!-- Actions -->
                <div class="flex overflow-hidden text-white">
                    @if (IsQueueMode)
                    {
                        // Queue mode actions
                        <div class="hidden items-center gap-1 group-hover:flex">
                            <div class="flex flex-col overflow-hidden">
                                <!-- Move Up Button -->
                                @if (index > 0)
                                {
                                    <Button
                                    Class="h-4 bg-transparent"
                                            OnClick="() => SafeAction(() => SongMoveUpInQueue.InvokeAsync(song), nameof(SongMoveUpInQueue), song)"
                                            StopPropagation="true" RemoveBorder="true">
                                        <Icon><ArrowUpIcon></ArrowUpIcon></Icon>
                                    </Button>
                                }

                                <!-- Move Down Button -->
                                @if (index < Songs.Count - 1)
                                {
                                    <Button Class="h-4 bg-transparent"
                                            OnClick="() => SafeAction(() => SongMoveDownInQueue.InvokeAsync(song), nameof(SongMoveDownInQueue), song)"
                                            StopPropagation="true" RemoveBorder="true">
                                        <Icon><ArrowDownIcon></ArrowDownIcon></Icon>
                                    </Button>
                                }

                            </div>
                            <!-- Remove from Queue Button -->
                            <Button Class="bg-transparent"
                                    OnClick="() => SafeAction(() => SongRemoveFromQueue.InvokeAsync(song), nameof(SongRemoveFromQueue), song)"
                                    StopPropagation="true" RemoveBorder="true">
                                <Icon><SquareMinusIcon /></Icon>
                            </Button>
                        </div>
                    }
                    else
                    {
                        // Regular mode actions
                        @if (song.InQueue)
                        {
                            <Button Class="bg-transparent"
                                    OnClick="() => SafeAction(() => SongRemoveFromQueue.InvokeAsync(song), nameof(SongRemoveFromQueue), song)"
                                    StopPropagation="true" RemoveBorder="true">
                                <Icon><SquareMinusIcon /></Icon>
                            </Button>
                        }
                        else
                        {
                            <Button Class=@($"bg-transparent {(isSelected ? "flex" : "invisible group-hover:visible")}")
                                    OnClick="() => SafeAction(() => SongAddToQueue.InvokeAsync(song), nameof(SongAddToQueue), song)"
                                    StopPropagation="true" RemoveBorder="true">
                                <Icon><SquarePlusIcon /></Icon>
                            </Button>
                        }

                        <Button Class=@($"bg-transparent {(isSelected ? "flex" : "invisible group-hover:visible")}")
                                OnClick="() => SafeAction(() => SongDeletionRequest.InvokeAsync(song), nameof(SongDeletionRequest), song)"
                                StopPropagation="true" RemoveBorder="true">
                            <Icon><EraserIcon /></Icon>
                        </Button>
                    }
                </div>
            </div>
        }
    </Virtualize>
</div>

@code {
    [Parameter] public List<Song> Songs { get; set; } = new();
    [Parameter] public Song? SelectedSong { get; set; }
    [Parameter] public EventCallback<Song> SelectedSongChanged { get; set; }
    [Parameter] public EventCallback<Song> SongDeletionRequest { get; set; }
    [Parameter] public EventCallback<Song> SongAddToQueue { get; set; }
    [Parameter] public EventCallback<Song> SongRemoveFromQueue { get; set; }
    [Parameter] public EventCallback<Song> SongMoveUpInQueue { get; set; }
    [Parameter] public EventCallback<Song> SongMoveDownInQueue { get; set; }
    [Parameter] public bool IsQueueMode { get; set; }

    private DateTime _lastKeyDownTime = DateTime.MinValue;

    private async Task Navigate(KeyboardEventArgs e)
    {
        if (Songs.Count == 0) return;

        var elapsed = (DateTime.Now - _lastKeyDownTime).TotalMilliseconds;
        if (elapsed <= 150) return; // debounce
        _lastKeyDownTime = DateTime.Now;

        try
        {
            var index = Songs.FindIndex(s => s.Id == SelectedSong?.Id);
            if (index == -1) index = 0;

            if (e.Code == "ArrowUp" && index > 0)
                await SelectionChanged(Songs[index - 1]);
            else if (e.Code == "ArrowDown" && index < Songs.Count - 1)
                await SelectionChanged(Songs[index + 1]);
            else if (e.Code == "Enter" && SelectedSong != null)
                Logger.LogInformation("Enter pressed on {Song}", SelectedSong.Title);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during keyboard navigation");
        }
    }

    private async Task SelectionChanged(Song song)
    {
        SelectedSong = song;
        Logger.LogInformation("Selected song: {Song}", song.Title);

        var index = Songs.FindIndex(s => s.Id == song.Id);
        if (index >= 0)
        {
            await JSRuntime.InvokeVoidAsync("ScrollWithHeight", "SongList", index);
        }

        await SelectedSongChanged.InvokeAsync(song);
    }

    private async Task SafeAction(Func<Task> action, string actionName, Song song)
    {
        try
        {
            await action();
            Logger.LogInformation("{Action} succeeded for {Song}", actionName, song.Title);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error while executing {Action} for {Song}", actionName, song.Title);
        }
    }
}