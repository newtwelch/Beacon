@page "/"
@inject SongService SongService
@inject IJSRuntime JSRuntime
@inject ProjectionService ProjectionService
@inject ILogger<SongLibrary> Logger

<div class="flex h-full w-full gap-4">

    <SongDeleteModal Visible="showConfirmDelete"
                     Song="pendingDeleteSong"
                     OnConfirm="ConfirmDelete"
                     OnCancel="CancelDelete">

    </SongDeleteModal>
    <!-- Sidebar -->
    <div class="flex h-full w-[450px] min-w-96 flex-col gap-3">
        @if (isEditMode && selectedSong is not null)
        {
            <div class="flex h-full min-h-0 flex-1 flex-col overflow-y-auto rounded-2xl bg-con1 p-4">

                <p class="mb-3 text-base leading-3">LYRIC EDITOR</p>
                <textarea class="mb-6 h-full w-full rounded-xl border-2 border-gray bg-black px-4 py-3 leading-snug font-extralight" spellcheck="false" 
                          value="@selectedSong.LyricText" @oninput="(e => { selectedSong.LyricText = e.Value.ToString(); UpdateLyrics(); })" />

                <p class="mb-3 leading-3">SEQUENCE</p>
                <input class="mb-6 rounded-xl border-2 border-gray bg-black px-4 py-3 text-xs font-light" value="@selectedSong.Sequence" @oninput="(e => { selectedSong.Sequence = e.Value.ToString(); UpdateLyrics(); })" placeholder="Sequence" />

                <p class="mb-3 leading-3">TAGS</p>
                <input class="mb-6 rounded-xl border-2 border-gray bg-black px-4 py-3 text-xs font-light" @bind="selectedSong.Tags" placeholder="Tags" />

            </div>
            
        }

        <!-- Rounded panel (search + list) -->
        <div class="flex min-h-0 flex-1 flex-col rounded-2xl bg-con1 p-4 @(isEditMode ? "hidden": "")">
            @if(!isQueueMode){
            <DebounceInput class="mb-3 h-11 w-full rounded-xl border-2 border-gray bg-black p-3"
                           DebounceTime="320"
                           placeholder="Search..."
                           OnValueChanged="OnSearchChanged"
                           Value="@searchText" />
            }
            <!-- THIS is the scrolling area -->   
            <div class="min-h-0 flex-1 overflow-y-auto">
                @if (songs.Any())
                {
                    <SongList Songs="songs"
                              SelectedSongChanged="SelectedSongChanged"
                              SelectedSong="selectedSong"
                              IsQueueMode="isQueueMode"
                              SongAddToQueue="AddToQueue"
                              SongRemoveFromQueue="RemoveFromQueue"
                              SongMoveUpInQueue="MoveUpInQueue"
                              SongMoveDownInQueue="MoveDownInQueue"
                              SongDeletionRequest="SongDeletionRequest" />
                }
                else
                {
                    <div class="flex h-full p-1 text-white/50">
                        No songs available
                    </div>
                }
            </div>
        </div>


        <!-- Buttons OUTSIDE the rounded panel -->
        @if (!isEditMode)
        {
            <div class="flex justify-between gap-3">
                <Button OnClick="QueueModeToggle">
                    <Icon>
                        @if (!isQueueMode)
                        {
                            <QueueListIcon></QueueListIcon>
                        }
                        else
                        {
                            <BareArrowLeftIcon></BareArrowLeftIcon>
                        }
                    </Icon>
                    <Text>@(isQueueMode ? "All Songs" : "Show Queue")</Text>
                </Button>

                @if (isQueueMode)
                {
                    <Button Class="bg-red-600 hover:text-white/50" OnClick="ClearQueue">
                        <Text>Clear Queue</Text>
                    </Button>
                }
                else
                {
                    <Button OnClick="AddSongClick">
                        <Text>Add Song</Text>
                    </Button>
                }
            </div>
            
        }

    </div>

    <div class="flex h-full w-full flex-col">

        @if (isEditMode && selectedSong is not null)
        {
            <div class="mb-4 flex items-start justify-between gap-3">
                <div class="">
                    <input class="mb-1 w-full rounded-xl border-2 border-gray bg-black px-4 py-3 text-sm font-light" spellcheck="false" @bind="selectedSong.Title" placeholder="Title" />
                    <br/>
                    <input class="mb-1 rounded-xl border-2 border-gray bg-black px-4 py-3 text-sm font-light" spellcheck="false" @bind="selectedSong.Author" placeholder="Author" />
                    <input class="mb-1 rounded-xl border-2 border-gray bg-black px-4 py-3 text-sm font-light" spellcheck="false" @bind="selectedSong.Key" placeholder="Key" />
                </div>
                <div class="flex flex-col items-center gap-1">

                    <Button OnClick="SaveEditClick" >
                        <Text>SAVE</Text>
                    </Button>
                    <Button OnClick="DiscardEditClick" RemoveBorder="true" Class="bg-transparent hover:text-red">
                        <Text>DISCARD</Text>
                    </Button>
                </div>
            </div>

            <input class="mb-1 w-48 rounded-xl border-2 border-gray bg-black px-4 py-3 text-sm font-light" spellcheck="false" @bind="selectedSong.Language" placeholder="Language" />
            <LyricList Lyrics="lyrics" SelectedLyricChanged="SelectedLyricChanged"/>

        }
        else if (selectedSong is not null)
        {
            <div class="mb-4 flex items-start justify-between gap-3">
                <div>
                    <h1 class="mb-1 text-3xl font-medium">@selectedSong?.Title</h1>
                    <h2 class="mb-6 font-light">@selectedSong?.Author @((!String.IsNullOrWhiteSpace(selectedSong?.Key) && !String.IsNullOrWhiteSpace(selectedSong?.Author)) ? "•" : "") @selectedSong?.Key</h2>
                </div>

                <div>

                    <Button OnClick="EditModeToggle" Class="h-full">
                        <Text>EDIT</Text>
                    </Button>
                </div>
            </div>
            <SongLanguageList Songs="languagesOfSelectedSong" SelectedSong="selectedSong" SelectedSongChanged="SelectedSongChanged" AddLanguage="AddLanguageClick" />
            <LyricList Lyrics="lyrics" SelectedLyricChanged="SelectedLyricChanged" />
        }

    </div>


</div>

